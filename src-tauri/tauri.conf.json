{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AINode",
  "version": "0.2.0",
  "identifier": "ai.ainode.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "copyright": "Apache-2.0. Made in Texas.",
    "shortDescription": "AINode on your desktop",
    "longDescription": "AINode on your desktop: point it at your master node and go. Made in Texas.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
